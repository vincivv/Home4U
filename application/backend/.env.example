# Backend environment template for local development and deployment.
#
# Copy this file to .env for local work:
#   cp .env.example .env
#
# Do not commit .env.

HOME4U_ENV=development
HOME4U_SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL is required. Local development defaults to this URL if DATABASE_URL
# is omitted, but production must set DATABASE_URL explicitly.
DATABASE_URL=postgresql+psycopg://home4u:password@localhost:5432/home4u

# Optional upload and public asset settings.
# HOME4U_UPLOAD_DIR=/absolute/path/to/uploads
# HOME4U_PUBLIC_ASSET_BASE_URL=https://your-domain.com
# HOME4U_CORS_ORIGINS=http://127.0.0.1:5173,https://your-frontend-domain.com
# HOME4U_MAX_UPLOAD_BYTES=20971520

# Optional Gemini enhancement layer used by app/services/ai_design.py.
HOME4U_AI_ENABLED=false
HOME4U_AI_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# HOME4U_GEMINI_TEXT_MODEL=gemini-2.0-flash-lite
# HOME4U_GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
# HOME4U_AI_TIMEOUT_SECONDS=45

# Optional Claude analysis provider used by app/services/ai_analysis.py.
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# HOME4U_AI_ANALYSIS_MODEL=claude-haiku-4-5-20251001
# HOME4U_AI_ANALYSIS_TIMEOUT_SECONDS=25

# Optional OpenAI-compatible upload feedback provider.
# HOME4U_AI_VISION_PROVIDER=openai
# HOME4U_AI_VISION_BASE_URL=https://api.openai.com/v1
# HOME4U_AI_VISION_API_KEY=replace-with-your-api-key
# HOME4U_AI_VISION_MODEL=gpt-4.1-mini
# HOME4U_AI_VISION_TIMEOUT_SECONDS=18

# Optional Google OpenAI-compatible vision provider.
# GOOGLE_API_KEY=replace-with-your-google-api-key
# HOME4U_GOOGLE_GEMINI_MODEL=gemini-2.0-flash-lite
# HOME4U_GOOGLE_GEMINI_TIMEOUT_SECONDS=20
